{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "WorkflowRecord": {
      "title": "WorkflowRecord",
      "description": "User discovered or approved workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "intent": { "type": "string", "maxLength": 1024 },
        "category": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["discovered", "approved", "active", "draft"] },
        "similarityScore": { "type": "number" },
        "repetitionCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "title", "status"]
    },
    "UserEvent": {
      "title": "UserEvent",
      "description": "Intercepted desktop event for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "app": { "type": "string", "maxLength": 64 },
        "actionType": { "type": "string", "maxLength": 64 },
        "actionLabel": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "app", "actionType"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini chat conversation item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string", "maxLength": 10000 },
        "modelUsed": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile"
    },
    "/users/{userId}/workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/WorkflowRecord" },
      "description": "Workflows owned by user"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/UserEvent" },
      "description": "Captured user events"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages for user"
    }
  }
}
